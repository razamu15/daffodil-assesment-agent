# Local development settings (apps/local-server and the agent CLI).
# Copy to .env (gitignored) and fill in. Nothing here is used by the deployed stack.

# Login password for the local app. Also handy for `npm run deploy -w infra`.
APP_PASSWORD=

# Which model the local agent calls: "anthropic" (Claude API) or "bedrock".
MODEL_PROVIDER=anthropic

# MODEL_PROVIDER=anthropic: key from console.anthropic.com, and the model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# MODEL_PROVIDER=bedrock: the deployed stack's model, and AWS credentials from
# your profile (e.g. AWS_PROFILE=daffodil).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# What the local server's in-memory store starts with:
#   empty     nothing; upload and paste the starter pack in the UI (the real flow)
#   documents the starter-pack documents, not yet read
#   full      documents + helpers, confirmed terms and September bills, checked
LOCAL_SEED=empty
