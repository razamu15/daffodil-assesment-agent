# Local development settings (apps/local-server and the agent CLI).
# Copy to .env (gitignored) and fill in. Nothing here is used by the deployed stack's
# Lambdas; DATA_BACKEND=aws only points the local server at the stack's data.

# Login password for the local app. Also handy for `npm run deploy -w infra`.
APP_PASSWORD=

# Which model the local agent calls: "anthropic" (Claude API) or "bedrock".
MODEL_PROVIDER=anthropic

# MODEL_PROVIDER=anthropic: key from console.anthropic.com, and the model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# MODEL_PROVIDER=bedrock: the deployed stack's model, and AWS credentials from
# your profile (e.g. AWS_PROFILE=daffodil).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# Where the local server keeps data and chat memory:
#   memory  in-process fakes; everything resets on restart (gate I1)
#   aws     the deployed stack's DynamoDB tables, uploads bucket and AgentCore
#           Memory (gate I2). Needs `npm run deploy` first and AWS credentials
#           (e.g. AWS_PROFILE=daffodil). Data persists; to start over:
#           npm run reset-aws-data -w @helper-assistant/local-server -- --yes
DATA_BACKEND=memory
# AWS_PROFILE=

# What the local server's store starts with (DATA_BACKEND=memory only; aws needs empty):
#   empty     nothing; upload and paste the starter pack in the UI (the real flow)
#   documents the starter-pack documents, not yet read
#   full      documents + helpers, confirmed terms and September bills, checked
LOCAL_SEED=empty
