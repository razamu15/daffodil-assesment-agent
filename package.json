{
  "name": "helper-assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/domain",
    "packages/core",
    "packages/store",
    "packages/agent",
    "packages/api",
    "apps/web",
    "apps/local-server",
    "apps/lambdas",
    "fixtures",
    "infra"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
